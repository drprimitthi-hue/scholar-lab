# ---- Public (browser) Firebase config: safe to expose; data is protected by security rules ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Only needed when FILE_STORAGE=firebase (or before moving files to Firebase Storage)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: Firebase App Check with reCAPTCHA Enterprise site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ---- Server-only secrets: set ONLY in Vercel (Encrypted) / local .env.local, never commit ----
# Paste the whole service-account JSON file content here (or use FIREBASE_SERVICE_ACCOUNT_BASE64 with its base64)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Random long string; Vercel Cron sends it as a Bearer token
CRON_SECRET=
# Set to "true" after App Check is configured to reject requests without a valid App Check token
APP_CHECK_ENFORCE=false

# ---- File storage: where uploaded PDFs/images are kept ----
# "cloudinary" = Cloudinary free plan, no card needed (files private; 10 MB per file; monthly allowance)
# "firebase"   = Firebase Storage in the lab's region (needs the Firebase Blaze plan)
FILE_STORAGE=cloudinary
# From the Cloudinary dashboard (Settings -> API Keys). The secret is server-only: mark it Sensitive.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Setup & licence (values come from the Control Centre) ----
# One-time code for the /setup page (min 24 characters)
SETUP_TOKEN=
# This lab's id and licence key, issued by the Control Centre
LAB_ID=
LICENCE_KEY=
# The Control Centre's public key and address
LICENCE_PUBLIC_KEY=
CONTROL_CENTRE_URL=
# Leave unset. "off" disables licence checks (only for a lab that is not managed by a Control Centre).
LICENCE_MODE=

# Optional: the public website address used in sitemap.xml (defaults to the Vercel production domain)
SITE_URL=

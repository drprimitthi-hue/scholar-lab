# Control Centre (its own Firebase project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# One-time code for /setup (min 24 chars)
SETUP_TOKEN=
# Licence signing keys: generated on the /setup page (or `npm run keys`). Keep the private key ONLY here.
LICENCE_PRIVATE_KEY=
LICENCE_PUBLIC_KEY=
# Public address of this Control Centre, e.g. https://control.example.org
CONTROL_CENTRE_URL=
# Releases: fine-grained GitHub token on the app repository only, with "Contents: read and write" and "Actions: read-only"
# (Actions is needed so a version is released only after its CI checks passed)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
